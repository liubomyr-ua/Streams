<div class="Streams_login_explanation">
    <table>
        {{#if invitingUser}}
            <tr class="Streams_complete_invitingUser">
                <td><img src="{{invitingUser.icon}}/50.jpg" title="{{invitingUser.displayName}} icon"></td>
                <td><div>{{invitingUser.displayName}}</div><div>{{invitingUser.text}}</div></td>
            </tr>
        {{/if}}
        {{#if showStreamPreview}}
            <tr class="Streams_complete_stream">
                <td><img src="{{streamIcon}}/50.jpg" title="{{stream.fields.title}}"></td>
                <td><div>{{stream.fields.title}}</div></td>
            </tr>
        {{/if}}
    </table>
    {{#if discount.description}}
    <div class="Streams_complete_discount">
        <div class="Streams_invited_discount">
            {{discount.description}}
        </div>
    </div>
    {{/if}}
    {{#if roles}}
    <div class="Streams_invited_roles">
        <div class="Streams_invited_roles_prompt">{{rolesPrompt}}</div>
        <ul>
        {{#each roles}}
            <li class="Streams_invited_role" data-label="{{this.label}}">
                <img src="{{this.icon}}/40.png" alt="">
                <span>{{this.title}}</span>
            </li>
        {{/each}}
        </ul>
    </div>
    {{/if}}
</div>