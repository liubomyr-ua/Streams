{
	"_comment": "Streams-\u10d8\u10e1 \u10d1\u10e0\u10eb\u10d0\u10dc\u10d4\u10d1\u10d8\u10e1 \u10e2\u10d4\u10e5\u10e1\u10e2\u10d8. &#39;commands&#39; = \u10e9\u10d5\u10d4\u10dc\u10d4\u10d1\u10d8\u10e1 \u10d4\u10e2\u10d8\u10d9\u10d4\u10e2\u10d4\u10d1\u10d8 (UI); &#39;phrases&#39; = \u10d0\u10db\u10dd\u10ea\u10dc\u10dd\u10d1\u10d8\u10da\u10d8 \u10e4\u10e0\u10d0\u10d6\u10d4\u10d1\u10d8, \u10e0\u10dd\u10db\u10da\u10d4\u10d1\u10d8\u10ea \u10d1\u10e0\u10eb\u10d0\u10dc\u10d4\u10d1\u10d8\u10d7 \u10d0\u10e0\u10d8\u10e1 \u10d0\u10d9\u10e0\u10d4\u10e4\u10d8\u10da\u10d8. \u10e4\u10e0\u10d0\u10d6\u10d8\u10e1 \u10e4\u10dd\u10e0\u10db\u10d4\u10d1\u10d8: &quot;substring&quot;, &quot;/regex/&quot;, \u10d0\u10dc \u10e8\u10d0\u10d1\u10da\u10dd\u10dc\u10e3\u10e0\u10d8 &quot;give {{name}} access&quot; \u2014 \u10d7\u10d8\u10d7\u10dd\u10d4\u10e3\u10da\u10d8 {{token}} \u10d9\u10dd\u10db\u10de\u10d8\u10da\u10d8\u10e0\u10d3\u10d4\u10d1\u10d0 \u10e9\u10d0\u10dc\u10d0\u10ec\u10d4\u10e0\u10d0\u10d3. Streams \u10d0\u10ee\u10da\u10d0 \u10e4\u10da\u10dd\u10d1\u10e1 \u10ec\u10d5\u10d3\u10dd\u10db\u10d8\u10e1 \u10d9\u10dd\u10dc\u10e2\u10e0\u10dd\u10da\u10d8\u10e1\u10d0 \u10d3\u10d0 \u10e1\u10e2\u10d8\u10da\u10d8\u10e1 \u10e8\u10d4\u10ea\u10d5\u10da\u10d8\u10e1 \u10d1\u10e0\u10eb\u10d0\u10dc\u10d4\u10d1\u10d4\u10d1\u10e1 (\u10d3\u10d0\u10db\u10db\u10e3\u10e8\u10d0\u10d5\u10d4\u10d1\u10da\u10d4\u10d1\u10d8 Streams/commands/streamCommand \u10d3\u10d0 Streams/commands/cssUpdate); \u10db\u10d4\u10d3\u10d8\u10d0 \u10d2\u10d4\u10db\u10d4\u10d1\u10d8\u10e1 \u10dc\u10d0\u10d5\u10d8\u10d2\u10d0\u10ea\u10d8\u10d0; \u10ee\u10d4\u10da\u10dd\u10d5\u10dc\u10e3\u10e0\u10d8 \u10d8\u10dc\u10e2\u10d4\u10da\u10d4\u10e5\u10e2\u10d8\u10e1 \u10d2\u10d4\u10db\u10d4\u10d1\u10d8\u10e1 \u10d2\u10d4\u10dc\u10d4\u10e0\u10d8\u10e0\u10d4\u10d1\u10d0.",
	"commands": {
		"tool/cssUpdate": "\u10e1\u10e2\u10d8\u10da\u10d8\u10e1 \u10e8\u10d4\u10ea\u10d5\u10da\u10d8\u10e1 \u10d8\u10dc\u10e1\u10e2\u10e0\u10e3\u10db\u10d4\u10dc\u10e2\u10d8",
		"stream/create": "\u10dc\u10d0\u10d9\u10d0\u10d3\u10d8\u10e1 \u10e8\u10d4\u10e5\u10db\u10dc\u10d0",
