{
	"_comment": "\u0422\u0435\u043a\u0441\u0442 \u043a\u043e\u043c\u0430\u043d\u0434 \u043f\u043e\u0442\u043e\u043a\u043e\u0432. &#39;commands&#39; = \u043c\u0435\u0442\u043a\u0438 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f (UI); &#39;phrases&#39; = \u0440\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u043d\u043d\u044b\u0435 \u0444\u0440\u0430\u0437\u044b, \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u043c\u044b\u0435 \u043f\u043e \u043a\u043e\u043c\u0430\u043d\u0434\u0435. \u0424\u043e\u0440\u043c\u044b \u0444\u0440\u0430\u0437: &quot;\u043f\u043e\u0434\u0441\u0442\u0440\u043e\u043a\u0430&quot;, &quot;/regex/&quot; \u0438\u043b\u0438 \u0448\u0430\u0431\u043b\u043e\u043d\u043d\u0430\u044f &quot;\u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f {{name}} &quot; \u2014 \u043a\u0430\u0436\u0434\u0430\u044f {{token}} \u044f \u043a\u043e\u043c\u043f\u0438\u043b\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0432 \u0437\u0430\u0445\u0432\u0430\u0442. \u0422\u0435\u043f\u0435\u0440\u044c \u043f\u043e\u0442\u043e\u043a\u0438 \u0432\u043b\u0430\u0434\u0435\u044e\u0442 \u043a\u043e\u043c\u0430\u043d\u0434\u0430\u043c\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0441\u0442\u0438\u043b\u044f (\u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0438 Streams/commands/streamCommand \u0438 Streams/commands/cssUpdate); \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0435\u0439 \u043c\u0435\u0434\u0438\u0430-\u043a\u043e\u0440\u0430\u0431\u043b\u0435\u0439; \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0435\u0439 \u043a\u043e\u0440\u0430\u0431\u043b\u0435\u0439 \u0418\u0418.",
	"commands": {
		"tool/cssUpdate": "\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0441\u0442\u0438\u043b\u044f",
