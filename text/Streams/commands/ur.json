{
	"_comment": "\u0627\u0633\u0679\u0631\u06cc\u0645\u0632 \u06a9\u0645\u0627\u0646\u0688 \u0679\u06cc\u06a9\u0633\u0679\u06d4 &#39;commands&#39; = \u0688\u0633\u067e\u0644\u06d2 \u0644\u06cc\u0628\u0644 (UI)\u061b &#39;\u062c\u0645\u0644\u06d2&#39; = \u062a\u0633\u0644\u06cc\u0645 \u0634\u062f\u06c1 \u062c\u0645\u0644\u06d2\u060c \u06a9\u0645\u0627\u0646\u0688 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u06a9\u0644\u06cc\u062f\u06d4 \u0641\u0642\u0631\u06d2 \u06a9\u06cc \u0634\u06a9\u0644\u06cc\u06ba: &quot;substring&quot;\u060c &quot;/regex/&quot;\u060c \u06cc\u0627 templated &quot;give {{name}} access&quot; \u2014 \u06c1\u0631 {{token}} \u0627\u06cc\u06a9 \u06a9\u06cc\u067e\u0686\u0631 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u0631\u062a\u0628 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u0627\u0633\u0679\u0631\u06cc\u0645\u0632 \u0627\u0628 \u0627\u06cc\u06a9\u0633\u06cc\u0633 \u06a9\u0646\u0679\u0631\u0648\u0644 \u0627\u0648\u0631 \u0631\u06cc \u0627\u0633\u0679\u0627\u0626\u0644 \u06a9\u0645\u0627\u0646\u0688\u0632 \u06a9\u06d2 \u0645\u0627\u0644\u06a9 \u06c1\u06cc\u06ba (\u06c1\u06cc\u0646\u0688\u0644\u0631 Streams/commands/streamCommand and Streams/commands/cssUpdate)\u061b \u0645\u06cc\u0688\u06cc\u0627 \u062c\u06c1\u0627\u0632\u0648\u06ba \u06a9\u06cc \u0646\u06cc\u0648\u06cc\u06af\u06cc\u0634\u0646\u061b AI \u062c\u06c1\u0627\u0632\u0648\u06ba \u06a9\u06cc \u0646\u0633\u0644\u06d4",
