{
	"_comment": "\u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u09ae\u09b8 \u0995\u09ae\u09be\u09a8\u09cd\u09a1 \u099f\u09c7\u0995\u09cd\u09b8\u099f\u0964 &#39;\u0995\u09ae\u09be\u09a8\u09cd\u09a1\u09b8&#39; = \u09a1\u09bf\u09b8\u09aa\u09cd\u09b2\u09c7 \u09b2\u09c7\u09ac\u09c7\u09b2 (\u0987\u0989\u0986\u0987); &#39;\u09ab\u09cd\u09b0\u09c7\u099c\u09c7\u09b8&#39; = \u09b8\u09cd\u09ac\u09c0\u0995\u09c3\u09a4 \u09ac\u09be\u0995\u09cd\u09af\u09be\u0982\u09b6, \u09af\u09be \u0995\u09ae\u09be\u09a8\u09cd\u09a1 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u099a\u09bf\u09b9\u09cd\u09a8\u09bf\u09a4\u0964 \u09ac\u09be\u0995\u09cd\u09af\u09be\u0982\u09b6\u09c7\u09b0 \u09a7\u09b0\u09a8: &quot;\u09b8\u09be\u09ac\u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u0982&quot;, &quot;/\u09b0\u09c7\u099c\u09c7\u0995\u09cd\u09b8/&quot;, \u0985\u09a5\u09ac\u09be \u099f\u09c7\u09ae\u09aa\u09cd\u09b2\u09c7\u099f\u09c7\u09a1 &quot;\u0997\u09bf\u09ad {{name}} \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8&quot; \u2014 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf {{token}} \u098f\u0995\u099f\u09bf \u0995\u09cd\u09af\u09be\u09aa\u099a\u09be\u09b0\u09c7 \u0995\u09ae\u09cd\u09aa\u09be\u0987\u09b2 \u09b9\u09af\u09bc\u0964 \u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u09ae\u09b8 \u098f\u0996\u09a8 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8-\u0995\u09a8\u09cd\u099f\u09cd\u09b0\u09cb\u09b2 \u098f\u09ac\u0982 \u09b0\u09bf\u09b8\u09cd\u099f\u09be\u0987\u09b2 \u0995\u09ae\u09be\u09a8\u09cd\u09a1\u09c7\u09b0 \u09ae\u09be\u09b2\u09bf\u0995 (\u09b9\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09b2\u09be\u09b0 \u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u09ae\u09b8/\u0995\u09ae\u09be\u09a8\u09cd\u09a1\u09b8/\u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u09ae\u0995\u09ae\u09be\u09a8\u09cd\u09a1 \u098f\u09ac\u0982 \u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u09ae\u09b8/\u0995\u09ae\u09be\u09a8\u09cd\u09a1\u09b8/\u09b8\u09bf\u098f\u09b8\u098f\u09b8\u0986\u09aa\u09a1\u09c7\u099f); \u09ae\u09bf\u09a1\u09bf\u09af\u09bc\u09be \u09a8\u09c7\u09ad\u09bf\u0997\u09c7\u09b6\u09a8 \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09c7; \u098f\u0986\u0987 \u099c\u09c7\u09a8\u09be\u09b0\u09c7\u09b6\u09a8 \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09c7\u0964",
	"commands": {
		"tool/cssUpdate": "\u09b0\u09bf\u09b8\u09cd\u099f\u09be\u0987\u09b2 \u099f\u09c1\u09b2",
		"stream/create": "\u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u09ae \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c1\u09a8",
		"stream/grantAccess": "\u09aa\u09cd\u09b0\u09ac\u09c7\u09b6\u09be\u09a7\u09bf\u0995\u09be\u09b0 \u09ae\u099e\u09cd\u099c\u09c1\u09b0 \u0995\u09b0\u09c1\u09a8",
		"stream/revokeAccess": "\u09aa\u09cd\u09b0\u09ac\u09c7\u09b6\u09be\u09a7\u09bf\u0995\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8"
