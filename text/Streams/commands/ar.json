{
	"_comment": "\u0646\u0635 \u0623\u0648\u0627\u0645\u0631 Streams. &quot;\u0627\u0644\u0623\u0648\u0627\u0645\u0631&quot; = \u062a\u0633\u0645\u064a\u0627\u062a \u0627\u0644\u0639\u0631\u0636 (\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645)\u061b &quot;\u0627\u0644\u0639\u0628\u0627\u0631\u0627\u062a&quot; = \u0639\u0628\u0627\u0631\u0627\u062a \u0645\u064f\u062a\u0639\u0631\u064e\u0651\u0641 \u0639\u0644\u064a\u0647\u0627\u060c \u0645\u064f\u0641\u0647\u0631\u0633\u0629 \u062d\u0633\u0628 \u0627\u0644\u0623\u0645\u0631. \u0623\u0634\u0643\u0627\u0644 \u0627\u0644\u0639\u0628\u0627\u0631\u0627\u062a: &quot;\u0633\u0644\u0633\u0644\u0629 \u0641\u0631\u0639\u064a\u0629&quot;\u060c &quot;/regex/&quot;\u060c \u0623\u0648 \u0642\u0627\u0644\u0628 &quot;\u0645\u0646\u062d {{name}} \u0625\u0630\u0646 \u0627\u0644\u0648\u0635\u0648\u0644&quot; - \u0643\u0644 {{token}} \u064a\u064f\u062a\u0631\u062c\u0645 \u0625\u0644\u0649 \u0644\u0642\u0637\u0629. \u064a\u062a\u0648\u0644\u0649 Streams \u0627\u0644\u0622\u0646 \u0623\u0648\u0627\u0645\u0631 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0648\u0635\u0648\u0644 \u0648\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0646\u0633\u064a\u0642 (\u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0627\u062a Streams/commands/streamCommand \u0648Streams/commands/cssUpdate)\u061b \u062a\u0646\u0642\u0644 \u0633\u0641\u0646 \u0627\u0644\u0648\u0633\u0627\u0626\u0637\u061b \u062a\u0648\u0644\u064a\u062f \u0633\u0641\u0646 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a.",
	"commands": {
