{
	"_comment": "\u0ab8\u0acd\u0a9f\u0acd\u0ab0\u0ac0\u0aae\u0acd\u0ab8 \u0a95\u0aae\u0abe\u0aa8\u0acd\u0aa1 \u0a9f\u0ac7\u0a95\u0acd\u0ab8\u0acd\u0a9f. &#39;\u0a95\u0aae\u0abe\u0aa8\u0acd\u0aa1\u0acd\u0ab8&#39; = \u0aa1\u0abf\u0ab8\u0acd\u0aaa\u0acd\u0ab2\u0ac7 \u0ab2\u0ac7\u0aac\u0ab2\u0acd\u0ab8 (UI); &#39;\u0aab\u0acd\u0ab0\u0ac7\u0ab8\u0ac0\u0ab8&#39; = \u0a93\u0ab3\u0a96\u0abe\u0aaf\u0ac7\u0ab2\u0abe \u0ab6\u0aac\u0acd\u0aa6\u0ab8\u0aae\u0ac2\u0ab9\u0acb, \u0a86\u0aa6\u0ac7\u0ab6 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a95\u0ac0 \u0a95\u0ab0\u0ac7\u0ab2. \u0ab6\u0aac\u0acd\u0aa6\u0ab8\u0aae\u0ac2\u0ab9 \u0ab8\u0acd\u0ab5\u0ab0\u0ac2\u0aaa\u0acb: &quot;\u0ab8\u0aac\u0ab8\u0acd\u0a9f\u0acd\u0ab0\u0abf\u0a82\u0a97&quot;, &quot;/regex/&quot;, \u0a85\u0aa5\u0ab5\u0abe \u0a9f\u0ac7\u0aae\u0acd\u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0ac7\u0aa1 &quot; {{name}} \u0a8d\u0a95\u0acd\u0ab8\u0ac7\u0ab8 \u0a86\u0aaa\u0acb&quot; - \u0aa6\u0ab0\u0ac7\u0a95 {{token}} \u0a95\u0ac7\u0aaa\u0acd\u0a9a\u0ab0\u0aae\u0abe\u0a82 \u0a95\u0aae\u0acd\u0aaa\u0abe\u0a87\u0ab2 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7. \u0ab8\u0acd\u0a9f\u0acd\u0ab0\u0ac0\u0aae\u0acd\u0ab8 \u0ab9\u0ab5\u0ac7 \u0a8f\u0a95\u0acd\u0ab8\u0ac7\u0ab8-\u0a95\u0a82\u0a9f\u0acd\u0ab0\u0acb\u0ab2 \u0a85\u0aa8\u0ac7 \u0ab0\u0abf\u0ab8\u0acd\u0a9f\u0abe\u0a87\u0ab2 \u0a86\u0aa6\u0ac7\u0ab6\u0acb (\u0ab9\u0ac7\u0aa8\u0acd\u0aa1\u0ab2\u0ab0\u0acd\u0ab8 \u0ab8\u0acd\u0a9f\u0acd\u0ab0\u0ac0\u0aae\u0acd\u0ab8/\u0a95\u0aae\u0abe\u0aa8\u0acd\u0aa1\u0acd\u0ab8/\u0ab8\u0acd\u0a9f\u0acd\u0ab0\u0ac0\u0aae\u0a95\u0aae\u0abe\u0aa8\u0acd\u0aa1 \u0a85\u0aa8\u0ac7 \u0ab8\u0acd\u0a9f\u0acd\u0ab0\u0ac0\u0aae\u0acd\u0ab8/\u0a95\u0aae\u0abe\u0aa8\u0acd\u0aa1\u0acd\u0ab8/css\u0a85\u0aaa\u0aa1\u0ac7\u0a9f) \u0aa8\u0ac0 \u0aae\u0abe\u0ab2\u0abf\u0a95\u0ac0 \u0aa7\u0ab0\u0abe\u0ab5\u0ac7 \u0a9b\u0ac7; \u0aae\u0ac0\u0aa1\u0abf\u0aaf\u0abe \u0ab6\u0abf\u0aaa \u0aa8\u0ac7\u0ab5\u0abf\u0a97\u0ac7\u0ab6\u0aa8; AI \u0ab6\u0abf\u0aaa \u0a9c\u0aa8\u0ab0\u0ac7\u0ab6\u0aa8.",
	"commands": {
