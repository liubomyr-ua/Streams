			"{{prompt}} \u12ed\u1300\u121d\u1229",
			"\u12e8 {{prompt}} \u1328\u12cb\u1273 \u12ed\u134d\u1320\u1229",
			"{{prompt}} \u12a5\u1295\u132b\u12c8\u1275",
			"{{prompt}} \u1295 \u12eb\u12cb\u1245\u1229"
		],
		"stream/grantAccess": [
			"\u1208 {{name}} \u12e8\u1356\u1235\u1273 \u1218\u12f3\u1228\u123b \u12ed\u1235\u1321",
			"{{name}} \u1356\u1235\u1275 \u12a0\u12f5\u122d\u130d",
