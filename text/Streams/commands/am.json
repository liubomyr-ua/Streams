{
	"_comment": "\u12e8\u12e5\u1228\u1276\u127d \u1275\u12d5\u12db\u12dd \u133d\u1211\u134d\u1362 &#39;\u1275\u12d5\u12db\u12de\u127d&#39; = \u12e8\u121b\u1233\u12eb \u1218\u1208\u12eb\u12ce\u127d (UI); &#39;\u1210\u1228\u130e\u127d&#39; = \u12e8\u121a\u1273\u12c8\u1241 \u1210\u1228\u130e\u127d\u1363 \u1260\u1275\u12d5\u12db\u12dd \u12e8\u1270\u1246\u1208\u1349\u1362 \u12e8\u1210\u1228\u130d \u1245\u122d\u133e\u127d\u1361 &quot;\u1295\u12d1\u1235 \u1215\u1265\u1228\u1241\u121d\u134a&quot;\u1363 &quot;/regex/&quot;\u1363 \u12c8\u12ed\u121d &quot;\u1208 {{name}} \u1218\u12f3\u1228\u123b \u12ed\u1235\u1321&quot; - \u12a5\u12eb\u1295\u12f3\u1295\u12f1 {{token}} \u12c8\u12f0 \u1240\u1228\u133b \u12eb\u1320\u1293\u1245\u122b\u120d\u1362 \u12e5\u1228\u1276\u127d \u12a0\u1201\u1295 \u12e8\u1218\u12f3\u1228\u123b-\u1241\u1325\u1325\u122d \u12a5\u1293 \u12e8\u12f3\u130d\u121d \u1245\u1325 \u1275\u12d5\u12db\u12de\u127d\u1295 \u1260\u1263\u1208\u1264\u1275\u1290\u1275 \u12ed\u12ed\u12db\u120d (\u1270\u1246\u1323\u1323\u122a\u12ce\u127d \u12e5\u1228\u1276\u127d/\u1275\u12d5\u12db\u12de\u127d/\u12e5\u1228\u1275Command \u12a5\u1293 \u12e5\u1228\u1276\u127d/\u1275\u12d5\u12db\u12de\u127d/cssUpdate)\u1364 \u121a\u12f2\u12eb \u12e8\u1218\u122d\u12a8\u1265 \u12a0\u1245\u1323\u132b\u1364 \u12e8AI \u1218\u120b\u12ad \u121b\u1218\u1295\u1328\u1275\u1362",
	"commands": {
		"tool/cssUpdate": "\u12e8\u12f3\u130d\u121d \u1245\u1325 \u1218\u1223\u122a\u12eb",
		"stream/create": "\u12e5\u1228\u1275 \u134d\u1320\u122d",
		"stream/grantAccess": "\u1218\u12f3\u1228\u123b \u12ed\u1235\u1321",
		"stream/revokeAccess": "\u1218\u12f3\u1228\u123b\u1295 \u123b\u122d"
	},
