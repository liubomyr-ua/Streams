			"{{name}} \u12a5\u1295\u12f2\u1208\u1325\u134d \u134d\u1240\u12f5\u1208\u1275",
			"{{name}} \u12a5\u1295\u12f0 \u12a5\u1295\u130d\u12f3 \u12eb\u12ad\u1209",
			"{{name}} \u1208\u1218\u1208\u1320\u134d \u12ed\u130b\u1265\u12d9"
		],
