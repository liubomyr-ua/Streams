			"\u1240\u1208\u1219\u1295 \u12c8\u12f0 {{prompt}} \u1240\u12ed\u122d",
			"\u1240\u1208\u121e\u1279\u1295 \u12c8\u12f0 {{prompt}} \u12ed\u1240\u12ed\u1229",
			"\u12a5\u1295\u12f0\u1308\u1293 \u1240\u1208\u121d \u1240\u1263\u12cd {{prompt}}",
			"\u12e8\u1218\u1233\u122a\u12eb\u12cd\u1295 {{prompt}} \u12a5\u1295\u12f0\u1308\u1293 \u12eb\u1235\u1270\u12ab\u12ad\u1209\u1275",
			"\u1240\u1208\u121e\u1279\u1295 {{prompt}} \u12eb\u12f5\u122d\u1309"
		],
