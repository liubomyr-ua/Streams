{
	"_comment": "\u0cb8\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0cae\u0ccd\u0cb8\u0ccd \u0c95\u0cae\u0cbe\u0c82\u0ca1\u0ccd \u0caa\u0ca0\u0ccd\u0caf. &#39;\u0c95\u0cae\u0cbe\u0c82\u0ca1\u0ccd\u200c\u0c97\u0cb3\u0cc1&#39; = \u0ca1\u0cbf\u0cb8\u0ccd\u200c\u0caa\u0ccd\u0cb2\u0cc7 \u0cb2\u0cc7\u0cac\u0cb2\u0ccd\u200c\u0c97\u0cb3\u0cc1 (UI); &#39;\u0cab\u0ccd\u0cb0\u0cc7\u0cb8\u0ccd\u200c\u0c97\u0cb3\u0cc1&#39; = \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0ca4\u0cc6 \u0caa\u0ca1\u0cc6\u0ca6 \u0ca8\u0cc1\u0ca1\u0cbf\u0c97\u0c9f\u0ccd\u0c9f\u0cc1\u0c97\u0cb3\u0cc1, \u0c86\u0c9c\u0ccd\u0c9e\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0c95\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0ca8\u0cc1\u0ca1\u0cbf\u0c97\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb0\u0cc2\u0caa\u0c97\u0cb3\u0cc1: &quot;\u0cb8\u0cac\u0ccd\u200c\u0cb8\u0ccd\u0c9f\u0ccd\u0cb0\u0cbf\u0c82\u0c97\u0ccd&quot;, &quot;/regex/&quot;, \u0c85\u0ca5\u0cb5\u0cbe \u0c9f\u0cc6\u0c82\u0caa\u0ccd\u0cb2\u0cc7\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0ca6 &quot; {{name}} \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cbf&quot; - \u0caa\u0ccd\u0cb0\u0ca4\u0cbf {{token}} \u0c95\u0ccd\u0caf\u0cbe\u0caa\u0ccd\u0c9a\u0cb0\u0ccd\u200c\u0c97\u0cc6 \u0c95\u0c82\u0caa\u0cc8\u0cb2\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0cb8\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0cae\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0c88\u0c97 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6-\u0ca8\u0cbf\u0caf\u0c82\u0ca4\u0ccd\u0cb0\u0ca3 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cb0\u0cc1\u0cb6\u0cc8\u0cb2\u0cbf \u0c86\u0c9c\u0ccd\u0c9e\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb5\u0cc6 (\u0cb9\u0ccd\u0caf\u0cbe\u0c82\u0ca1\u0ccd\u0cb2\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1 Streams/commands/streamCommand \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 Streams/commands/cssUpdate); \u0cae\u0cc0\u0ca1\u0cbf\u0caf\u0cbe \u0cb6\u0cbf\u0caa\u0ccd\u0cb8\u0ccd \u0ca8\u0ccd\u0caf\u0cbe\u0cb5\u0cbf\u0c97\u0cc7\u0cb7\u0ca8\u0ccd; AI \u0cb6\u0cbf\u0caa\u0ccd\u0cb8\u0ccd \u0c9c\u0ca8\u0cb0\u0cc7\u0cb7\u0ca8\u0ccd.",
	"commands": {
		"tool/cssUpdate": "\u0cae\u0cb0\u0cc1\u0cb6\u0cc8\u0cb2\u0cbf \u0c89\u0caa\u0c95\u0cb0\u0ca3",
		"stream/create": "\u0cb8\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0cae\u0ccd \u0cb0\u0c9a\u0cbf\u0cb8\u0cbf",
