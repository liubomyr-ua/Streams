{
	"_comment": "\u0422\u0435\u043a\u0441\u0442 \u043d\u0430 \u043a\u043e\u043c\u0430\u043d\u0434\u0430\u0442\u0430 \u043d\u0430 Streams. \u201ecommands\u201c = \u043f\u0440\u0438\u043a\u0430\u0437 \u043d\u0430 \u0435\u0442\u0438\u043a\u0435\u0442\u0438 (UI); \u201ephrases\u201c = \u043f\u0440\u0435\u043f\u043e\u0437\u043d\u0430\u0435\u043d\u0438 \u0444\u0440\u0430\u0437\u0438, \u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438 \u0441\u043e \u043a\u043e\u043c\u0430\u043d\u0434\u0430. \u0424\u043e\u0440\u043c\u0438 \u043d\u0430 \u0444\u0440\u0430\u0437\u0438: \u201esubstring\u201c, \u201e/regex/\u201c \u0438\u043b\u0438 \u0448\u0430\u0431\u043b\u043e\u043d\u0438\u0437\u0438\u0440\u0430\u043d\u043e \u201egive {{name}} access\u201c \u2014 \u0441\u0435\u043a\u043e\u0458\u0430 {{token}} \u0441\u0435 \u043a\u043e\u043c\u043f\u0430\u0458\u043b\u0438\u0440\u0430 \u0432\u043e \u0444\u0430\u045c\u0430\u045a\u0435. Streams \u0441\u0435\u0433\u0430 \u0433\u0438 \u043f\u043e\u0441\u0435\u0434\u0443\u0432\u0430 \u043a\u043e\u043c\u0430\u043d\u0434\u0438\u0442\u0435 \u0437\u0430 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0430 \u043d\u0430 \u043f\u0440\u0438\u0441\u0442\u0430\u043f \u0438 \u0440\u0435\u0441\u0442\u0438\u043b\u0438\u0437\u0438\u0440\u0430\u045a\u0435 (\u0440\u0430\u043a\u0443\u0432\u0430\u0447\u0438 Streams/commands/streamCommand \u0438 Streams/commands/cssUpdate); \u041d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0458\u0430 \u043d\u0430 \u043c\u0435\u0434\u0438\u0443\u043c\u0441\u043a\u0438 \u0431\u0440\u043e\u0434\u043e\u0432\u0438; \u0413\u0435\u043d\u0435\u0440\u0438\u0440\u0430\u045a\u0435 \u043d\u0430 \u0431\u0440\u043e\u0434\u043e\u0432\u0438 \u0441\u043e \u0432\u0435\u0448\u0442\u0430\u0447\u043a\u0430 \u0438\u043d\u0442\u0435\u043b\u0438\u0433\u0435\u043d\u0446\u0438\u0458\u0430.",
	"commands": {
		"tool/cssUpdate": "\u0410\u043b\u0430\u0442\u043a\u0430 \u0437\u0430 \u0440\u0435\u0441\u0442\u0438\u043b\u0438\u0437\u0438\u0440\u0430\u045a\u0435",
