			"\u043e\u0434\u0437\u0435\u043c\u0435\u0442\u0435 \u0433\u043e \u043f\u0440\u0438\u0441\u0442\u0430\u043f\u043e\u0442 \u043d\u0430 {{name}}",
			"\u043e\u0442\u0441\u0442\u0440\u0430\u043d\u0438 {{name}} \u043e\u0434 \u043f\u043e\u0442\u043e\u043a\u043e\u0442",
