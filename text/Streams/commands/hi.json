{
	"_comment": "\u0938\u094d\u091f\u094d\u0930\u0940\u092e\u094d\u0938 \u0915\u092e\u093e\u0902\u0921 \u091f\u0947\u0915\u094d\u0938\u094d\u091f\u0964 &#39;\u0915\u092e\u093e\u0902\u0921&#39; = \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0932\u0947\u092c\u0932 (UI); &#39;\u0935\u093e\u0915\u094d\u092f\u093e\u0902\u0936&#39; = \u0915\u092e\u093e\u0902\u0921 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u0939\u091a\u093e\u0928\u0947 \u0917\u090f \u0935\u093e\u0915\u094d\u092f\u093e\u0902\u0936\u0964 \u0935\u093e\u0915\u094d\u092f\u093e\u0902\u0936 \u0915\u0947 \u0930\u0942\u092a: &quot;\u0938\u092c\u0938\u094d\u091f\u094d\u0930\u093f\u0902\u0917&quot;, &quot;/\u0930\u0947\u0917\u0947\u0915\u094d\u0938/&quot;, \u092f\u093e \u091f\u0947\u092e\u094d\u092a\u0932\u0947\u091f\u0947\u0921 &quot; {{name}} \u090f\u0915\u094d\u0938\u0947\u0938 \u0926\u0947\u0902&quot; \u2014 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 {{token}} \u090f\u0915 \u0915\u0948\u092a\u094d\u091a\u0930 \u092e\u0947\u0902 \u0938\u0902\u0915\u0932\u093f\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u094d\u091f\u094d\u0930\u0940\u092e\u094d\u0938 \u0905\u092c \u090f\u0915\u094d\u0938\u0947\u0938-\u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0914\u0930 \u0930\u0940\u0938\u094d\u091f\u093e\u0907\u0932 \u0915\u092e\u093e\u0902\u0921 (\u0939\u0948\u0902\u0921\u0932\u0930 Streams/commands/streamCommand \u0914\u0930 Streams/commands/cssUpdate) \u0915\u093e \u092e\u093e\u0932\u093f\u0915 \u0939\u0948; \u092e\u0940\u0921\u093f\u092f\u093e \u0928\u0947\u0935\u093f\u0917\u0947\u0936\u0928 \u0915\u094b \u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948; AI \u091c\u0928\u0930\u0947\u0936\u0928 \u0915\u094b \u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
