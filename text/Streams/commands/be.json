{
	"_comment": "\u0422\u044d\u043a\u0441\u0442 \u043a\u0430\u043c\u0430\u043d\u0434\u044b Streams. &#39;commands&#39; = \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u043c\u0435\u0442\u0430\u043a (\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043b\u044c\u043d\u0456\u0446\u043a\u0456 \u0456\u043d\u0442\u044d\u0440\u0444\u0435\u0439\u0441); &#39;phrases&#39; = \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u043d\u044b\u044f \u0444\u0440\u0430\u0437\u044b, \u043a\u043b\u044e\u0447\u043e\u043c \u044f\u043a\u0456\u0445 \u0437&#39;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043a\u0430\u043c\u0430\u043d\u0434\u0430. \u0424\u043e\u0440\u043c\u044b \u0444\u0440\u0430\u0437: &quot;substring&quot;, &quot;/regex/&quot; \u0430\u0431\u043e \u0448\u0430\u0431\u043b\u043e\u043d\u043d\u044b\u044f &quot;give {{name}} access&quot; \u2014 \u043a\u043e\u0436\u043d\u0430\u044f {{token}} \u043a\u0430\u043c\u043f\u0456\u043b\u044e\u0435\u0446\u0446\u0430 \u045e \u0437\u0430\u043f\u0456\u0441. Streams \u0446\u044f\u043f\u0435\u0440 \u0432\u0430\u043b\u043e\u0434\u0430\u0435 \u043a\u0430\u043c\u0430\u043d\u0434\u0430\u043c\u0456 \u043a\u0430\u043d\u0442\u0440\u043e\u043b\u044e \u0434\u043e\u0441\u0442\u0443\u043f\u0443 \u0456 \u0437\u043c\u0435\u043d\u044b \u0441\u0442\u044b\u043b\u0456\u0437\u0430\u0446\u044b\u0456 (\u0430\u043f\u0440\u0430\u0446\u043e\u045e\u0448\u0447\u044b\u043a\u0456 Streams/commands/streamCommand \u0456 Streams/commands/cssUpdate); \u043d\u0430\u0432\u0456\u0433\u0430\u0446\u044b\u044f \u043f\u0430 \u043a\u0430\u0440\u0430\u0431\u043b\u044f\u0445 \u043c\u0435\u0434\u044b\u044f; \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u044b\u044f \u043a\u0430\u0440\u0430\u0431\u043b\u0451\u045e \u0448\u0442\u0443\u0447\u043d\u044b\u043c \u0456\u043d\u0442\u044d\u043b\u0435\u043a\u0442\u0430\u043c.",
	"commands": {
		"tool/cssUpdate": "\u0406\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0437\u043c\u0435\u043d\u044b \u0441\u0442\u044b\u043b\u044e",
		"stream/create": "\u0421\u0442\u0432\u0430\u0440\u044b\u0446\u044c \u0442\u0440\u0430\u043d\u0441\u043b\u044f\u0446\u044b\u044e",
		"stream/grantAccess": "\u0414\u0430\u0446\u044c \u0434\u043e\u0441\u0442\u0443\u043f",
		"stream/revokeAccess": "\u0410\u0434\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0434\u043e\u0441\u0442\u0443\u043f"
	},
	"phrases": {
		"tool/cssUpdate": [
			"\u0437\u043c\u044f\u043d\u0456\u0446\u044c \u043a\u043e\u043b\u0435\u0440 \u043d\u0430 {{prompt}}",
