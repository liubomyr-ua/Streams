			"\u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c {{name}} \u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0432\u0430\u0446\u044c \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u043b\u0435\u043d\u043d\u0456",
			"\u0434\u0430\u0434\u0430\u0446\u044c {{name}} \u0443 \u044f\u043a\u0430\u0441\u0446\u0456 \u0433\u043e\u0441\u0446\u044f",
			"\u0437\u0430\u043f\u0440\u0430\u0441\u0456\u0446\u044c {{name}} \u0430\u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0432\u0430\u0446\u044c \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u043b\u0435\u043d\u043d\u0435"
		],
		"stream/revokeAccess": [
			"\u0432\u044b\u0434\u0430\u043b\u0456\u0446\u044c \u0434\u043e\u0441\u0442\u0443\u043f \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043b\u044c\u043d\u0456\u043a\u0430 {{name}}",
			"\u0430\u0434\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0434\u043e\u0441\u0442\u0443\u043f \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043b\u044c\u043d\u0456\u043a\u0430 {{name}}",
			"\u043f\u0430\u0437\u0431\u0430\u0432\u0456\u0446\u044c {{name}} \u0434\u043e\u0441\u0442\u0443\u043f\u0443",
			"\u0432\u044b\u0434\u0430\u043b\u0456\u0446\u044c {{name}} \u0437 \u043f\u0430\u0442\u043e\u043a\u0443",
			"\u0437\u0430\u0431\u043b\u0430\u043a\u0430\u0432\u0430\u0446\u044c {{name}} \u0430\u0434 \u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0446\u044b\u0456"
		]
