		"slide/prev": "\u0cb9\u0cbf\u0c82\u0ca6\u0cbf\u0ca8 \u0cb8\u0ccd\u0cb2\u0cc8\u0ca1\u0ccd\u200c\u0c97\u0cc6 \u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cbf. \u0cb8\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0cae\u0ccd\u200c\u0c97\u0cb3\u0cc1/\u0cb8\u0ccd\u0cb2\u0cc8\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0cb0\u0cb8\u0cc2\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 {slideIndex: current-1}.",
		"slide/first": "\u0cae\u0cca\u0ca6\u0cb2 \u0cb8\u0ccd\u0cb2\u0cc8\u0ca1\u0ccd\u200c\u0c97\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf. \u0cb8\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0cae\u0ccd\u200c\u0c97\u0cb3\u0cc1/\u0cb8\u0ccd\u0cb2\u0cc8\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0cb0\u0cb8\u0cc2\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 {slideIndex: 0}.",
		"slide/last": "\u0c95\u0cca\u0ca8\u0cc6\u0caf \u0cb8\u0ccd\u0cb2\u0cc8\u0ca1\u0ccd\u200c\u0c97\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf. \u0cb8\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0cae\u0ccd\u200c\u0c97\u0cb3\u0cc1/\u0cb8\u0ccd\u0cb2\u0cc8\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0cb0\u0cb8\u0cc2\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 {slideIndex: 9999}.",
