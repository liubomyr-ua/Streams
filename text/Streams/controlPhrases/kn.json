		"reveal/next": "\u0cae\u0cc1\u0c82\u0ca6\u0cbf\u0ca8 \u0caa\u0ccd\u0cb0\u0c97\u0ca4\u0cbf\u0cb6\u0cc0\u0cb2 \u0c85\u0c82\u0cb6\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb9\u0cbf\u0cb0\u0c82\u0c97\u0caa\u0ca1\u0cbf\u0cb8\u0cbf. \u0cb8\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0cae\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1/\u0cac\u0cb9\u0cbf\u0cb0\u0c82\u0c97\u0caa\u0ca1\u0cbf\u0cb8\u0cc1\u0cb5\u0cbf\u0c95\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0cb0\u0cb8\u0cc2\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 {revealIndex: current+1}.",
		"video/play": "\u0cb5\u0cc0\u0ca1\u0cbf\u0caf\u0cca \u0caa\u0ccd\u0cb2\u0cc7 \u0cae\u0cbe\u0ca1\u0cbf. \u0cb8\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0cae\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1/\u0caa\u0ccd\u0cb2\u0cc7 \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0cb0\u0cb8\u0cc2\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 {}.",
		"video/pause": "\u0cb5\u0cc0\u0ca1\u0cbf\u0caf\u0cca\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cbf\u0cb0\u0cbe\u0cae\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf. \u0cb8\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0cae\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0cb0\u0cb8\u0cc2\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6/\u0cb5\u0cbf\u0cb0\u0cbe\u0cae {}.",
		"video/seek": "\u0cb8\u0c82\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb8\u0cae\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1. \u0cb8\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0cae\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1/\u0c95\u0ccb\u0cb0\u0cbf\u0c95\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0cb0\u0cb8\u0cc2\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 {pos: \u0cb8\u0cc6\u0c95\u0cc6\u0c82\u0ca1\u0cc1\u0c97\u0cb3\u0cc1}. \u0cb8\u0cc6\u0cb0\u0cc6\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 {\u0cb8\u0cae\u0caf}.",
		"video/seek/relative": "\u0c86\u0cab\u0ccd\u200c\u0cb8\u0cc6\u0c9f\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0cb8\u0cc0\u0c95\u0ccd. \u0cb8\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0cae\u0ccd\u200c\u0c97\u0cb3\u0cc1/\u0cb8\u0cc0\u0c95\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cca\u0cb0\u0cb8\u0cc2\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 {pos: &#39;+/-seconds&#39;}. \u0cb8\u0cc6\u0cb0\u0cc6\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 {\u0cb8\u0cae\u0caf}.",
